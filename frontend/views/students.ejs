<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Students</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        min-height: 100vh;
        padding: 32px;
        background: #f8fafc;
      }

      .wrap {
        max-width: 900px;
        margin: 0 auto;
        background: white;
        padding: 32px;
        border-radius: 16px;
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.12);
      }

      table {
        width: 100%;
        border-collapse: collapse;
        margin-top: 20px;
      }

      th,
      td {
        border: 1px solid #cbd5e1;
        padding: 12px;
        text-align: left;
      }

      th {
        background: #e2e8f0;
      }

      .empty,
      .error,
      .hint {
        color: #475569;
      }

      .error {
        color: #b91c1c;
      }

      .back {
        display: inline-block;
        margin-top: 20px;
        color: #0f172a;
        text-decoration: none;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <main class="wrap">
      <h2>Student List</h2>
      <p class="hint">Retrieved from Flask at <%= backendUrl %>.</p>

      <% if (error) { %>
      <p class="error"><%= error %></p>
      <% } %>

      <% if (students && students.length) { %>
      <table>
        <thead>
          <tr>
            <th>Name</th>
            <th>Email</th>
          </tr>
        </thead>
        <tbody>
          <% students.forEach((student) => { %>
          <tr>
            <td><%= student.name %></td>
            <td><%= student.email %></td>
          </tr>
          <% }); %>
        </tbody>
      </table>
      <% } else { %>
      <p class="empty">No students saved yet.</p>
      <% } %>

      <a class="back" href="/">Back to form</a>
    </main>
  </body>
</html>