<!doctype html>
<html>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>Student Form</title>
    <style>
      body {
        font-family: Arial, sans-serif;
        margin: 0;
        min-height: 100vh;
        display: grid;
        place-items: center;
        background: linear-gradient(135deg, #f8fafc, #e2e8f0);
      }

      .card {
        width: min(92vw, 520px);
        background: white;
        padding: 32px;
        border-radius: 16px;
        box-shadow: 0 20px 50px rgba(15, 23, 42, 0.12);
      }

      label {
        display: block;
        margin-top: 16px;
        margin-bottom: 6px;
        font-weight: 600;
      }

      input {
        width: 100%;
        box-sizing: border-box;
        padding: 12px 14px;
        border: 1px solid #cbd5e1;
        border-radius: 10px;
        font-size: 1rem;
      }

      button {
        margin-top: 20px;
        padding: 12px 18px;
        border: 0;
        border-radius: 10px;
        background: #0f172a;
        color: white;
        font-size: 1rem;
        cursor: pointer;
      }

      .hint {
        color: #475569;
        font-size: 0.95rem;
        margin-top: 8px;
      }

      .error {
        margin: 0 0 16px;
        color: #b91c1c;
      }

      .actions {
        margin-top: 18px;
      }

      .link {
        color: #0f172a;
        text-decoration: none;
        font-weight: 600;
      }
    </style>
  </head>
  <body>
    <main class="card">
      <h2>Student Form</h2>
      <p class="hint">The Express app submits to Flask using server-side fetch at <%= backendUrl %>.</p>

      <% if (error) { %>
      <p class="error"><%= error %></p>
      <% } %>

      <form action="/submit" method="POST">
        <label for="name">Name:</label>
        <input id="name" type="text" name="name" required />

        <label for="email">Email:</label>
        <input id="email" type="email" name="email" required />

        <button type="submit">Submit</button>
      </form>

      <div class="actions">
        <a class="link" href="/students">View saved students</a>
      </div>
    </main>
  </body>
</html>